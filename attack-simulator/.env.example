# Local UI and API flow. Mock mode returns a synthetic tone and never clones speech.
VOICE_PROVIDER=mock
MOCK_PROVIDER_DELAY_MS=250

# Real Fish Audio integration.
# VOICE_PROVIDER=fish-audio
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_MODEL=s2.1-pro-free
# FISH_AUDIO_TIMEOUT_MS=120000

# Mock mode is refused in production unless this explicit switch is enabled.
# ALLOW_MOCK_PROVIDER=false
